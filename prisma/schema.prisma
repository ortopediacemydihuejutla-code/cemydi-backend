generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
  schemas   = ["accounts", "catalog", "management", "public"]
}

model User {
  id                      Int                     @id @default(autoincrement())
  nombre                  String
  correo                  String                  @unique
  password                String
  telefono                String?
  direccion               String?
  rol                     Rol                     @default(CLIENT)
  createdAt               DateTime                @default(now())
  activo                  Boolean                 @default(true)
  emailVerifiedAt         DateTime?
  authTokens              AuthToken[]
  loginAttempts           LoginAttempt[]
  sessions                UserSession[]
  approvedReviews         Review[]                @relation("ApprovedByAdmin")
  reviews                 Review[]                @relation("UserReviews")
  shoppingCart            ShoppingCart?
  rentalRequests          RentalRequest[]         @relation("RentalRequestUser")
  approvedRentals         RentalRequest[]         @relation("RentalRequestApprovedBy")
  statusUpdatedRentals    RentalRequest[]         @relation("RentalRequestStatusUpdatedBy")
  rentalDocuments         RentalDocument[]        @relation("RentalDocumentOwner")
  reviewedRentalDocuments RentalDocument[]        @relation("RentalDocumentReviewedBy")
  rentalStatusHistory     RentalStatusHistory[]   @relation("RentalStatusHistoryActor")
  depositResolvedRentals  RentalRequest[]         @relation("RentalRequestDepositResolvedBy")
  adminNotificationReads  AdminNotificationRead[]

  @@map("users")
  @@schema("accounts")
}

model AdminNotificationRead {
  userId         Int      @map("userId")
  notificationId String   @map("notificationId")
  readAt         DateTime @default(now()) @map("readAt")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, notificationId])
  @@index([readAt])
  @@map("admin_notification_reads")
  @@schema("management")
}

model Product {
  id               Int                 @id @default(autoincrement())
  nombre           String
  slug             String              @unique
  marca            String
  modelo           String
  descripcion      String
  medidas          String?
  pesoSoportado    String?
  material         String?
  contenidoCaja    String?
  indicacionesUso  String?
  precio           Float
  clasificacion    String
  stock            Int
  proveedor        String
  tipoAdquisicion  TipoAdquisicion
  requiereReceta   Boolean             @default(false)
  rentalDailyPrice Float?
  rentalMinDays    Int                 @default(1)
  rentalDeposit    Float               @default(0)
  rentalTerms      String?
  createdAt        DateTime            @default(now())
  activo           Boolean             @default(true)
  images           ProductImage[]
  promotionLinks   PromotionProduct[]
  reviews          Review[]
  cartItems        ShoppingCartItem[]
  rentalItems      RentalRequestItem[]

  @@index([clasificacion], map: "idx_products_clasificacion")
  @@index([clasificacion, tipoAdquisicion, requiereReceta], map: "idx_products_filtros_busqueda")
  @@index([requiereReceta], map: "idx_products_requiere_receta")
  @@index([tipoAdquisicion], map: "idx_products_tipo_adquisicion")
  @@map("products")
  @@schema("catalog")
}

model ProductImage {
  id                 Int      @id @default(autoincrement())
  productId          Int
  imageUrl           String
  cloudinaryPublicId String?
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
  @@schema("catalog")
}

model Promotion {
  id                      Int                    @id @default(autoincrement())
  discountPercent         Int                    @default(10)
  startAt                 DateTime
  endAt                   DateTime
  imageStrategy           PromotionImageStrategy @default(AUTO)
  imageUrl                String?
  imageCloudinaryPublicId String?
  createdAt               DateTime               @default(now())
  descripcion             String                 @default("")
  products                PromotionProduct[]

  @@index([startAt, endAt])
  @@map("promotions")
  @@schema("management")
}

model PromotionProduct {
  promotionId Int
  productId   Int
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@index([productId])
  @@map("promotion_products")
  @@schema("management")
}

model Coupon {
  id              Int                @id @default(autoincrement())
  code            String             @unique
  description     String
  discountType    CouponDiscountType
  discountValue   Float
  minimumPurchase Float              @default(0)
  maximumDiscount Float?
  usageLimit      Int?
  usedCount       Int                @default(0)
  startAt         DateTime
  endAt           DateTime
  active          Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  carts           ShoppingCart[]

  @@index([active, startAt, endAt])
  @@map("coupons")
  @@schema("management")
}

model Brand {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique
  createdAt DateTime @default(now())

  @@map("brands")
  @@schema("catalog")
}

model Classification {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique
  createdAt DateTime @default(now())

  @@map("classifications")
  @@schema("catalog")
}

model Supplier {
  id         Int      @id @default(autoincrement())
  nombre     String   @unique
  encargado  String
  repartidor String
  direccion  String
  createdAt  DateTime @default(now())

  @@map("suppliers")
  @@schema("management")
}

model Review {
  id           Int          @id @default(autoincrement())
  productId    Int
  userId       Int
  rating       Int
  comment      String
  status       ReviewStatus @default(PENDING)
  showOnHome   Boolean      @default(false)
  approvedById Int?
  approvedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  approvedBy   User?        @relation("ApprovedByAdmin", fields: [approvedById], references: [id])
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user         User         @relation("UserReviews", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([status])
  @@index([productId])
  @@index([userId])
  @@map("reviews")
  @@schema("management")
}

model BackupRecord {
  id        Int          @id @default(autoincrement())
  fileName  String       @map("fileName")
  sizeBytes Int          @map("sizeBytes")
  createdAt DateTime     @default(now()) @map("createdAt")
  origin    BackupOrigin @default(MANUAL)

  @@index([createdAt])
  @@index([origin, createdAt])
  @@map("database_backups")
  @@schema("management")
}

model BackupSchedule {
  id            Int       @id @default(1)
  isEnabled     Boolean   @default(false) @map("isEnabled")
  intervalDays  Int       @default(1) @map("intervalDays")
  runAtTime     String    @default("03:00") @map("runAtTime")
  retentionDays Int       @default(7) @map("retentionDays")
  lastRunAt     DateTime? @map("lastRunAt")
  nextRunAt     DateTime? @map("nextRunAt")
  createdAt     DateTime  @default(now()) @map("createdAt")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updatedAt")

  @@map("database_backup_schedule")
  @@schema("management")
}

model MaintenanceSchedule {
  id           Int       @id @default(1)
  isEnabled    Boolean   @default(false) @map("isEnabled")
  intervalDays Int       @default(1) @map("intervalDays")
  runAtTime    String    @default("04:00") @map("runAtTime")
  operation    String    @default("VACUUM_ANALYZE")
  tableName    String?   @map("tableName")
  lastRunAt    DateTime? @map("lastRunAt")
  nextRunAt    DateTime? @map("nextRunAt")
  createdAt    DateTime  @default(now()) @map("createdAt")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updatedAt")

  @@map("database_maintenance_schedule")
  @@schema("management")
}

model AboutPage {
  id                Int      @id @default(1)
  heroTitle         String   @default("Quiénes somos")
  heroSubtitle      String   @default("Cuidamos tu movilidad con orientación cercana, productos confiables y acompañamiento humano en cada etapa.")
  missionTitle      String   @default("Misión")
  missionText       String   @default("Brindar soluciones ortopédicas, de rehabilitación y cuidado en casa con asesoría clara, productos de calidad y atención cercana para mejorar la movilidad y bienestar de cada persona.")
  visionTitle       String   @default("Visión")
  visionText        String   @default("Ser la ortopedia de referencia en la región por nuestra calidez, innovación y capacidad de acompañar a pacientes, familias e instituciones con soluciones oportunas.")
  valuesTitle       String   @default("Valores")
  values            Json     @default("[\"Empatía\", \"Confianza\", \"Responsabilidad\", \"Servicio\", \"Calidad\"]")
  storyTitle        String   @default("Atención pensada para personas reales")
  storyText         String   @default("En CEMYDI reunimos experiencia, disponibilidad y orientación para que elegir un equipo ortopédico sea más sencillo. Escuchamos tu necesidad, resolvemos dudas y buscamos la alternativa adecuada para compra, renta o seguimiento.")
  heroImageUrl      String?
  secondaryImageUrl String?
  updatedAt         DateTime @default(now()) @updatedAt
  createdAt         DateTime @default(now())

  @@map("about_page")
  @@schema("management")
}

model LegalDocument {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  description String
  sections    Json
  updatedAt   DateTime @default(now()) @updatedAt
  createdAt   DateTime @default(now())

  @@map("legal_documents")
  @@schema("management")
}

model UserSession {
  id               String    @id @default(cuid())
  tokenId          String    @unique @map("tokenId")
  refreshTokenHash String?   @unique @map("refreshTokenHash")
  userId           Int       @map("userId")
  createdAt        DateTime  @default(now()) @map("createdAt")
  expiresAt        DateTime  @map("expiresAt")
  lastSeenAt       DateTime  @default(now()) @map("lastSeenAt")
  endedAt          DateTime? @map("endedAt")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, endedAt, expiresAt])
  @@index([lastSeenAt])
  @@map("user_sessions")
  @@schema("accounts")
}

model LoginAttempt {
  id          Int      @id @default(autoincrement())
  userId      Int?     @map("userId")
  correo      String
  ipAddress   String?  @map("ipAddress")
  success     Boolean
  reason      String?
  attemptedAt DateTime @default(now()) @map("attemptedAt")
  user        User?    @relation(fields: [userId], references: [id])

  @@index([attemptedAt])
  @@index([success, attemptedAt])
  @@index([ipAddress, attemptedAt])
  @@map("login_attempts")
  @@schema("accounts")
}

model AuthToken {
  id           String           @id @default(cuid())
  userId       Int              @map("userId")
  correo       String
  purpose      AuthTokenPurpose
  tokenHash    String?          @unique
  codeHash     String?
  attemptCount Int              @default(0) @map("attemptCount")
  expiresAt    DateTime         @map("expiresAt")
  consumedAt   DateTime?        @map("consumedAt")
  createdAt    DateTime         @default(now()) @map("createdAt")
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, consumedAt, expiresAt])
  @@index([correo, purpose, consumedAt, expiresAt])
  @@map("auth_tokens")
  @@schema("accounts")
}

model ShoppingCart {
  id        String             @id @default(cuid())
  userId    Int                @unique @map("userId")
  couponId  Int?               @map("couponId")
  createdAt DateTime           @default(now()) @map("createdAt")
  updatedAt DateTime           @updatedAt @map("updatedAt")
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon    Coupon?            @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items     ShoppingCartItem[]

  @@index([couponId])
  @@map("shopping_carts")
  @@schema("accounts")
}

model ShoppingCartItem {
  id              Int             @id @default(autoincrement())
  cartId          String          @map("cartId")
  productId       Int             @map("productId")
  quantity        Int
  mode            CartItemMode    @default(VENTA)
  rentalStartDate DateTime?       @map("rentalStartDate")
  rentalEndDate   DateTime?       @map("rentalEndDate")
  rentalNotes     String?         @map("rentalNotes")
  createdAt       DateTime        @default(now()) @map("createdAt")
  updatedAt       DateTime        @updatedAt @map("updatedAt")
  cart            ShoppingCart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  rentalDocument  RentalDocument?

  @@index([cartId, productId, mode])
  @@index([productId])
  @@map("shopping_cart_items")
  @@schema("accounts")
}

model RentalRequest {
  id                    String                @id @default(cuid())
  folio                 String?               @unique
  userId                Int                   @map("userId")
  status                RentalRequestStatus   @default(PENDING)
  subtotal              Float                 @default(0)
  depositTotal          Float                 @default(0) @map("depositTotal")
  total                 Float                 @default(0)
  depositStatus         RentalDepositStatus   @default(PENDING) @map("depositStatus")
  depositReturnedAmount Float                 @default(0) @map("depositReturnedAmount")
  depositRetainedAmount Float                 @default(0) @map("depositRetainedAmount")
  depositNotes          String?               @map("depositNotes")
  depositResolvedAt     DateTime?             @map("depositResolvedAt")
  depositResolvedById   Int?                  @map("depositResolvedById")
  notes                 String?
  applicantName         String?               @map("applicantName")
  applicantEmail        String?               @map("applicantEmail")
  applicantPhone        String?               @map("applicantPhone")
  isForAnotherPerson    Boolean               @default(false) @map("isForAnotherPerson")
  patientName           String?               @map("patientName")
  patientRelationship   String?               @map("patientRelationship")
  deliveryMethod        RentalDeliveryMethod? @map("deliveryMethod")
  deliveryAddress       String?               @map("deliveryAddress")
  deliveryNeighborhood  String?               @map("deliveryNeighborhood")
  deliveryPostalCode    String?               @map("deliveryPostalCode")
  deliveryMunicipality  String?               @map("deliveryMunicipality")
  deliveryReferences    String?               @map("deliveryReferences")
  preferredSchedule     String?               @map("preferredSchedule")
  rentalTermsAcceptedAt DateTime?             @map("rentalTermsAcceptedAt")
  privacyAcceptedAt     DateTime?             @map("privacyAcceptedAt")
  rejectedReason        String?               @map("rejectedReason")
  approvedById          Int?                  @map("approvedById")
  approvedAt            DateTime?             @map("approvedAt")
  rejectedAt            DateTime?             @map("rejectedAt")
  cancelledAt           DateTime?             @map("cancelledAt")
  deliveredAt           DateTime?             @map("deliveredAt")
  returnedAt            DateTime?             @map("returnedAt")
  statusUpdatedById     Int?                  @map("statusUpdatedById")
  statusUpdatedAt       DateTime              @default(now()) @map("statusUpdatedAt")
  createdAt             DateTime              @default(now()) @map("createdAt")
  updatedAt             DateTime              @updatedAt @map("updatedAt")
  user                  User                  @relation("RentalRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy            User?                 @relation("RentalRequestApprovedBy", fields: [approvedById], references: [id])
  statusUpdatedBy       User?                 @relation("RentalRequestStatusUpdatedBy", fields: [statusUpdatedById], references: [id])
  depositResolvedBy     User?                 @relation("RentalRequestDepositResolvedBy", fields: [depositResolvedById], references: [id])
  items                 RentalRequestItem[]
  statusHistory         RentalStatusHistory[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("rental_requests")
  @@schema("management")
}

model RentalStatusHistory {
  id              Int                  @id @default(autoincrement())
  rentalRequestId String               @map("rentalRequestId")
  fromStatus      RentalRequestStatus? @map("fromStatus")
  toStatus        RentalRequestStatus  @map("toStatus")
  note            String?
  actorId         Int?                 @map("actorId")
  createdAt       DateTime             @default(now()) @map("createdAt")
  rentalRequest   RentalRequest        @relation(fields: [rentalRequestId], references: [id], onDelete: Cascade)
  actor           User?                @relation("RentalStatusHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([rentalRequestId, createdAt])
  @@index([actorId])
  @@map("rental_status_history")
  @@schema("management")
}

model RentalRequestItem {
  id                           Int             @id @default(autoincrement())
  rentalRequestId              String          @map("rentalRequestId")
  productId                    Int             @map("productId")
  quantity                     Int
  startDate                    DateTime        @map("startDate")
  endDate                      DateTime        @map("endDate")
  days                         Int
  dailyPrice                   Float           @map("dailyPrice")
  deposit                      Float           @default(0)
  lineSubtotal                 Float           @map("lineSubtotal")
  lineDeposit                  Float           @default(0) @map("lineDeposit")
  lineTotal                    Float           @map("lineTotal")
  notes                        String?
  productNameSnapshot          String?         @map("productNameSnapshot")
  productBrandSnapshot         String?         @map("productBrandSnapshot")
  productModelSnapshot         String?         @map("productModelSnapshot")
  productSkuSnapshot           String?         @map("productSkuSnapshot")
  productImageSnapshot         String?         @map("productImageSnapshot")
  productClassSnapshot         String?         @map("productClassSnapshot")
  prescriptionRequiredSnapshot Boolean?        @map("prescriptionRequiredSnapshot")
  createdAt                    DateTime        @default(now()) @map("createdAt")
  rentalRequest                RentalRequest   @relation(fields: [rentalRequestId], references: [id], onDelete: Cascade)
  product                      Product         @relation(fields: [productId], references: [id])
  rentalDocument               RentalDocument?

  @@index([rentalRequestId])
  @@index([productId])
  @@index([startDate, endDate])
  @@map("rental_request_items")
  @@schema("management")
}

model RentalDocument {
  id                  String                 @id @default(uuid())
  userId              Int                    @map("userId")
  shoppingCartItemId  Int?                   @unique @map("shoppingCartItemId")
  rentalRequestItemId Int?                   @unique @map("rentalRequestItemId")
  assetId             String                 @unique @map("assetId")
  publicId            String                 @map("publicId")
  resourceType        CloudinaryResourceType @map("resourceType")
  deliveryType        CloudinaryDeliveryType @default(AUTHENTICATED) @map("deliveryType")
  format              String
  bytes               Int
  originalFilename    String                 @map("originalFilename")
  mimeType            String                 @map("mimeType")
  status              RentalDocumentStatus   @default(PENDIENTE)
  uploadedAt          DateTime               @default(now()) @map("uploadedAt")
  associatedAt        DateTime?              @map("associatedAt")
  cleanupAfter        DateTime?              @map("cleanupAfter")
  pendingAssetCleanup Json?                  @map("pendingAssetCleanup")
  reviewedAt          DateTime?              @map("reviewedAt")
  reviewedById        Int?                   @map("reviewedById")
  rejectionReason     String?                @map("rejectionReason")
  updatedAt           DateTime               @updatedAt @map("updatedAt")
  user                User                   @relation("RentalDocumentOwner", fields: [userId], references: [id], onDelete: Cascade)
  shoppingCartItem    ShoppingCartItem?      @relation(fields: [shoppingCartItemId], references: [id], onDelete: SetNull)
  rentalRequestItem   RentalRequestItem?     @relation(fields: [rentalRequestItemId], references: [id], onDelete: SetNull)
  reviewedBy          User?                  @relation("RentalDocumentReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId, uploadedAt])
  @@index([cleanupAfter])
  @@index([status])
  @@map("rental_documents")
  @@schema("management")
}

enum CartItemMode {
  VENTA
  RENTA

  @@schema("public")
}

enum RentalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  DELIVERED
  RETURNED

  @@schema("public")
}

enum RentalDeliveryMethod {
  PICKUP
  HOME_DELIVERY

  @@schema("public")
}

enum RentalDepositStatus {
  PENDING
  RETURNED
  RETAINED
  PARTIALLY_RETAINED

  @@schema("public")
}

enum RentalDocumentStatus {
  PENDIENTE
  EN_REVISION
  APROBADO
  RECHAZADO

  @@schema("public")
}

enum CloudinaryResourceType {
  IMAGE
  RAW

  @@schema("public")
}

enum CloudinaryDeliveryType {
  AUTHENTICATED

  @@schema("public")
}

enum TipoAdquisicion {
  VENTA
  RENTA
  MIXTO

  @@schema("public")
}

enum PromotionImageStrategy {
  AUTO
  CUSTOM

  @@schema("management")
}

enum CouponDiscountType {
  PERCENT
  FIXED

  @@schema("management")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("public")
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION_LINK
  PASSWORD_RESET_CODE

  @@schema("public")
}

enum BackupOrigin {
  MANUAL
  AUTOMATIC
  TABLE

  @@schema("public")
}

enum Rol {
  ADMIN
  CLIENT

  @@schema("public")
}
